{
  "manifest_version": 3,
  "name": "Fig Jam Theme",
  "version": "1.0.0",
  "description": "A warm vintage Chrome theme in fig-jam tones — deep wine chrome over a pale peach page.",
  "icons": {
    "128": "logo/logo.png"
  },
  "theme": {
    "colors": {
      "frame":                        [124, 14, 68],
      "frame_inactive":               [110, 13, 61],
      "toolbar":                      [142, 18, 73],
      "tab_text":                     [242, 218, 206],
      "bookmark_text":                [242, 218, 206],
      "ntp_background":               [242, 218, 206],
      "ntp_text":                     [74, 10, 40],
      "ntp_link":                     [124, 14, 68],
      "ntp_header":                   [212, 154, 154],
      "button_background":            [212, 154, 154],
      "button_background_secondary":  [170, 94, 122],
      "omnibox_background":           [255, 246, 241],
      "toolbar_button_icon":          [242, 218, 206]
    },
    "properties": {
      "ntp_button_background":    [170, 94, 122],
      "ntp_button_hover":         [154, 82, 112],
      "ntp_logo_alternate":       1,
      "ntp_single_row_shortcuts": true
    },
    "color_scheme": "light",
    "default_color_scheme": "light"
  }
}
